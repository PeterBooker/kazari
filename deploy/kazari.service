[Unit]
Description=Kazari artifact host
Documentation=https://kazari.io/docs/ https://github.com/PeterBooker/kazari
After=network-online.target
Wants=network-online.target
# Keep restarting through a long outage, such as of the identity provider
# or the network, rather than giving up after five quick failures.
StartLimitIntervalSec=0

[Service]
Type=simple
# The binary is /usr/bin/kazari from a package, /usr/local/bin/kazari when
# installed by hand or by install.sh.
ExecSearchPath=/usr/local/bin:/usr/bin
ExecStart=kazari serve --config /etc/kazari/kazari.yaml
Restart=on-failure
RestartSec=10s

# Secrets belong in kazari.env (mode 0600), not in kazari.yaml, which
# refers to them as ${KAZARI_TLS_DNS_API_TOKEN}, ${KAZARI_AUTH_ADMIN_TOKEN}
# and ${KAZARI_AUTH_OIDC_CLIENT_SECRET}. Start from deploy/kazari.env.example:
#   install -m 0600 deploy/kazari.env.example /etc/kazari/kazari.env
# sudo kazari check and sudo kazari admin read the same file, beside
# kazari.yaml.
EnvironmentFile=-/etc/kazari/kazari.env

# The service user exists only while the service runs. data_dir defaults to
# /var/lib/kazari, the StateDirectory below; another directory also needs
# ReadWritePaths=.
DynamicUser=yes
StateDirectory=kazari
# tls.mode: files: the service user reads the certificate files through a
# group that owns them (chgrp kazari-tls, chmod 0640 on both):
# SupplementaryGroups=kazari-tls
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
