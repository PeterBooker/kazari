[Unit]
Description=Agalma artifact host
Documentation=https://github.com/PeterBooker/agalma
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agalma serve --config /etc/agalma/agalma.yaml
Restart=on-failure
RestartSec=2s

# Secrets belong in agalma.env (mode 0600), not in agalma.yaml, which
# refers to them as ${AGALMA_AUTH_ADMIN_TOKEN}, ${AGALMA_TLS_DNS_API_TOKEN}
# and ${AGALMA_AUTH_OIDC_CLIENT_SECRET}. Start from deploy/agalma.env.example:
#   install -m 0600 deploy/agalma.env.example /etc/agalma/agalma.env
EnvironmentFile=-/etc/agalma/agalma.env

DynamicUser=yes
StateDirectory=agalma
Environment=AGALMA_DATA_DIR=/var/lib/agalma
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
