# For goreleaser, which builds the binary outside the image. Digest-pinned; the maintenance skill
# updates them.
FROM --platform=$BUILDPLATFORM busybox:1.37@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec AS data
RUN mkdir /data

# No RUN in this stage: the release builds every platform on one runner, without emulation.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
# goreleaser puts each platform's binary under its name in the build context.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/kazari /usr/local/bin/kazari
# Owned by nonroot (65532): a new named volume copies it, so the server can write.
COPY --from=data --chown=65532:65532 /data /var/lib/kazari
VOLUME /var/lib/kazari
EXPOSE 80 443
ENV KAZARI_DATA_DIR=/var/lib/kazari
ENTRYPOINT ["/usr/local/bin/kazari"]
# serve reads /etc/kazari/kazari.yaml when it is mounted, else the KAZARI_* environment.
CMD ["serve"]
