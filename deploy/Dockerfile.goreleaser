# syntax=docker/dockerfile:1
# check=error=true
# Dependabot refreshes the digests; the maintenance skill moves the tags.
FROM --platform=$BUILDPLATFORM busybox:1.38@sha256:a46257e06c82ad85242d0d38077d0a52d9896389ca60a1a59d3463db586e5fa4 AS data
RUN mkdir /data

# No RUN in this stage: the release builds every platform on one runner, without emulation.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
# goreleaser puts each platform's binary under its name in the build context.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/kazari /usr/local/bin/kazari
# A new named volume copies this directory's owner, so the server can write to it.
COPY --from=data --chown=65532:65532 /data /var/lib/kazari
# The base sets it too; stated so that another base tag cannot run as root.
USER 65532:65532
VOLUME /var/lib/kazari
EXPOSE 80 443
ENV KAZARI_DATA_DIR=/var/lib/kazari
# The admin socket in the data volume needs no token.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --start-interval=1s --retries=3 \
    CMD ["/usr/local/bin/kazari", "admin", "health"]
ENTRYPOINT ["/usr/local/bin/kazari"]
# serve reads /etc/kazari/kazari.yaml when it is mounted, else the KAZARI_* environment.
CMD ["serve"]
