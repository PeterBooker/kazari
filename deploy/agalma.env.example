# Secrets for Agalma. Copy to .env (development) or /etc/agalma/agalma.env
# (systemd EnvironmentFile) and keep it mode 0600. Values here are read by
# ${NAME} references in agalma.yaml and as AGALMA_* overrides; a variable
# already set in the process environment always wins over this file.

# At least 32 characters (Agalma refuses to start with a shorter one):
#   openssl rand -hex 32
AGALMA_AUTH_ADMIN_TOKEN=change-me
AGALMA_TLS_DNS_API_TOKEN=
# AGALMA_AUTH_OIDC_CLIENT_SECRET=
