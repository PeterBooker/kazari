# Secrets for Kazari. Copy to .env (development) or /etc/kazari/kazari.env
# (systemd EnvironmentFile) and keep it mode 0600. Values here are read by
# ${NAME} references in kazari.yaml and as KAZARI_* overrides; a variable
# already set in the process environment always wins over this file.

# At least 32 characters (Kazari refuses to start with a shorter one):
#   openssl rand -hex 32
KAZARI_AUTH_ADMIN_TOKEN=change-me
KAZARI_TLS_DNS_API_TOKEN=
# KAZARI_AUTH_OIDC_CLIENT_SECRET=
